  "observations": [
    {
      "id": "RLT01",
      "class": "SOURCE_SUPPORTED",
      "claim": "Public original-checkpoint-gate synchronous implementation exists. CDB is not the exclusive public executable implementation.",
      "sources": [
        "README.md:103–114",
        "vllm_rlt/models/ouro.py:223–290",
        "vllm_rlt/engine/llm_engine.py:420–460"
      ],
      "limit": "This worker did not execute or qualify vllm-rlt."
    },
    {
      "id": "RLT02",
      "class": "SOURCE_SUPPORTED_NOMINAL_POLICY",
      "claim": "Ordinary ouro can explicitly request threshold .5, min_loops 2, max_loops 4, last_exited, synchronous execution and full-depth prefill.",
      "sources": [
        "vllm_rlt/sampling_params.py:6–38",
        "vllm_rlt/config.py:10–21,81–106",
        "vllm_rlt/engine/llm_engine.py:400–460"
      ],
      "limit": "Nominal policy compatibility is not numerical, quality, timing or graph-coverage parity."
    },
    {
      "id": "RLT03",
      "class": "SOURCE_NUMERICAL_DIFFERENCE",
      "claim": "RLT evaluates logits.float().sigmoid(), then Python-float survival and 1-survival. Pinned CDB evaluates sigmoid(signal).float().item(), then separately accumulates CDF and survival.",
      "sources": [
        "vllm_rlt/worker/model_runner.py:495,521–524",
        "vllm_rlt/engine/llm_engine.py:425,451–460",
        "https://github.com/kschwethelm/continuous-depth-batching/blob/abdfae0adbdd12be8c6123ccb34eee98a38afb39/src/looped_cdb/continuous_depth_batching/exit_policy.py#L150"
      ],
      "limit": "Cast-order and expression differences do not prove an observed branch mismatch. Near-threshold decisions need a separate numerical test."
    },
    {
      "id": "RLT04",
      "class": "SOURCE_SUPPORTED",
      "claim": "Async ordinary adaptive ouro is rejected. Async uses delayed, random-lookahead or replay policies, except its separate fixed-depth speculative path.",
      "sources": [
        "vllm_rlt/engine/llm_engine.py:95–103",
        "docs/cdb_runtime.md:45–47,98–104"
      ],
      "limit": "The same checkpoint gate weights do not make delayed stopping the same policy."
    },
    {
      "id": "RLT05",
      "class": "SOURCE_SUPPORTED",
      "claim": "Per-row request/depth cache descriptors and final-exit KV copying to skipped depth planes are implemented.",
      "sources": [
