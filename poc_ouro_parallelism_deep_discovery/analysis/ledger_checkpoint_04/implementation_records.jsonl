{"line": 12, "origin": "artifacts/certified_operator_sources.jsonl", "original": {"assertion_tolerance": 1e-12, "bound_trials": 100, "dense_attention_logits_0_0_values_0_2": 1.0, "directed_rounding_proof": false, "end_utc": "2026-10-19T11:07:49.419581Z", "equal_values_dense": 3.0, "equal_values_selected": 3.0, "evidence": "ANALYTIC_SANITY_CPU_NOT_MODEL_VALIDATION", "gpu_executed": false, "input_drift": 0.2, "minimum_bound_slack": 0.37737913962509273, "ouro_executed": false, "record_type": "cpu_probe", "reproduction_python": "import math, random\nsilu=lambda a:a/(1+math.exp(-a))\ndef dot(a,b):return sum(x*y for x,y in zip(a,b))\ndef norm(a):return math.sqrt(dot(a,a))\ndef softmax(a):\n e=[math.exp(x-max(a)) for x in a]\n return [x/sum(e) for x in e]\nrng=random.Random(0)\nslack=float('inf')\nfor trial in range(100):\n q=[rng.uniform(-1,1) for _ in range(3)]\n k=[[rng.uniform(-1,1) for _ in range(3)] for _ in range(8)]\n v=[rng.uniform(-2,2) for _ in range(8)]\n mu=[[sum(t[d] for t in k[c:c+2])/2 for d in range(3)] for c in range(0,8,2)]\n radius=[max(norm([t[d]-mu[c//2][d] for d in range(3)]) for t in k[c:c+2]) for c in range(0,8,2)]\n a=[dot(q,t) for t in k]\n p=softmax(a)\n dense=sum(t*u for t,u in zip(p,v))\n zs=sum(math.exp(t) for t in a[:2])\n selected=sum(math.exp(t)*u for t,u in zip(a[:2],v[:2]))/zs\n upper=sum(2*math.exp(dot(q,mu[c])+norm(q)*radius[c]) for c in range(1,4))\n mass_bound=upper/(zs+upper)\n bound=mass_bound*max(abs(t-selected) for t in v[2:])\n actual=abs(dense-selected)\n assert actual<=bound+1e-12 and sum(p[2:])<=mass_bound+1e-12\n slack=min(slack,bound-actual)\nprint(slack,silu(-1),silu(-.01))", "seed": 0, "selected_first_attention": 0.0, "silu_minus_one": -0.2689414213699951, "silu_minus_point_zero_one": -0.00497500020833125, "start_utc": "2026-10-19T11:07:49.411639Z", "threshold_point_one_changes_silu_minus_point_zero_one": true, "tied_weight_new_gate": 0.1, "tied_weight_old_gate": -0.1}}
