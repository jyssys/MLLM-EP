diff --git a/python/dinfer/model/modeling_llada2_moe_sglang.py b/python/dinfer/model/modeling_llada2_moe_sglang.py
index 8031e1d..83c007c 100755
--- a/python/dinfer/model/modeling_llada2_moe_sglang.py
+++ b/python/dinfer/model/modeling_llada2_moe_sglang.py
@@ -701,6 +701,294 @@ class LLaDA2SparseMoeBlock(nn.Module):
         # print('moe output', final_hidden_states.shape)
