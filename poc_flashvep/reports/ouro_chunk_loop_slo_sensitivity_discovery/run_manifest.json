  "RLT_diff": "diff --git a/vllm_rlt/config.py b/vllm_rlt/config.py\nindex f2ae951..ae28ee6 100644\n--- a/vllm_rlt/config.py\n+++ b/vllm_rlt/config.py\n@@ -57,11 +57,17 @@ class SchedulerConfig:\n     admission_scan_limit: int = 64\n     max_admission_bypasses: int = 8\n     prefill_chunk_size: int = 128\n+    # PoC: consecutive prefill-only loops per scheduling boundary.\n+    prefill_loop_group_size: int = 1\n     max_prefill_batches_before_decode: int = 1\n     policy: str = \"fcfs\"\n     enable_preemption: bool = False\n \n     def __post_init__(self):\n+        if self.prefill_loop_group_size not in (1, 2, 4):\n+            raise ValueError(\"prefill_loop_group_size must be 1, 2 or 4\")\n+        if self.mode == \"mixed\" and self.prefill_loop_group_size != 1:\n+            raise ValueError(\"grouped prefill must not advance mixed decode rows\")\n         for name in (\n             \"max_num_seqs\",\n             \"max_num_batched_tokens\",\ndiff --git a/vllm_rlt/core/scheduler.py b/vllm_rlt/core/scheduler.py\nindex b2442d7..2dd2489 100644\n--- a/vllm_rlt/core/scheduler.py\n+++ b/vllm_rlt/core/scheduler.py\n@@ -33,6 +33,7 @@ class ScheduledRequest:\n     chunk_start: int | None = None\n     completes_prompt: bool = False\n     phase: RequestPhase | None = None\n+    loop_count: int = 1\n \n \n @dataclass(frozen=True)\n@@ -531,6 +532,8 @@ class Scheduler:\n             # plane's causal prefix covers the run. Tokens past num_preluded_tokens\n             # have no resident prelude and cannot run yet.\n             boundary = request.prefill_depth_ranges[first_token_depth]\n+            group = min(self.config.prefill_loop_group_size,\n+                        self.total_ut_steps - first_token_depth)\n             count = min(\n                 token_budget,\n                 self.config.prefill_chunk_size,\n@@ -544,8 +547,9 @@ class Scheduler:\n                 count,\n                 depth=first_token_depth,\n                 chunk_start=request.prefill_chunk_start,\n+                loop_count=group,\n                 completes_prompt=(\n-                    first_token_depth == len(request.prefill_depth_ranges) - 1\n+                    first_token_depth + group == len(request.prefill_depth_ranges)\n                     and start + count == len(request.prompt_token_ids)\n                 ),\n             )\n@@ -707,14 +711,17 @@ class Scheduler:\n         # Assertion: phase == RequestPhase.PREFILLING_RECURRENT\n         depth = scheduled_request.depth\n         boundaries = request.prefill_depth_ranges\n-        boundaries[depth][0] = end\n-        if depth + 1 < total_depths:\n-            boundaries[depth + 1][1] = end\n-        else:\n-            request.num_prefilled_tokens = end\n+        group_end = depth + scheduled_request.loop_count\n+        for advanced_depth in range(depth, group_end):\n+            assert boundaries[advanced_depth][0] == start, \"causal prompt frontier hole\"\n+            boundaries[advanced_depth][0] = end\n+            if advanced_depth + 1 < total_depths:\n+                boundaries[advanced_depth + 1][1] = end\n+            else:\n+                request.num_prefilled_tokens = end\n \n         chunk_complete = end == request.num_preluded_tokens\n-        if depth + 1 < total_depths or not chunk_complete:\n+        if group_end < total_depths or not chunk_complete:\n             self.enqueue(request, RequestPhase.PREFILLING_RECURRENT)\n             return PrefillProgress(False, False)\n \ndiff --git a/vllm_rlt/worker/executor.py b/vllm_rlt/worker/executor.py\nindex 87ba27d..700d6a8 100644\n--- a/vllm_rlt/worker/executor.py\n+++ b/vllm_rlt/worker/executor.py\n@@ -56,7 +56,7 @@ def build_execution_batch(scheduled_batch: SchedulerOutput, total_depths: int) -\n                 token_count=scheduled_request.token_count,\n                 depth=depth,\n                 chunk_start=scheduled_request.chunk_start if chunk else None,\n-                retain_chunk=chunk and (operation == Operation.PRELUDE or depth + 1 < total_depths),\n+                retain_chunk=chunk and (operation == Operation.PRELUDE or depth + scheduled_request.loop_count < total_depths),\n                 retain_last=scheduled_request.completes_prompt if chunk else True,\n                 emit_gate=phase == RequestPhase.RECURRENT,\n                 input_tokens=tuple(\n@@ -68,7 +68,8 @@ def build_execution_batch(scheduled_batch: SchedulerOutput, total_depths: int) -\n         )\n         operations.add(operation)\n         loop_counts.add(\n-            total_depths if phase == RequestPhase.PREFILL else int(operation == Operation.RECURRENT)\n+            total_depths if phase == RequestPhase.PREFILL else\n+            scheduled_request.loop_count if operation == Operation.RECURRENT else 0\n         )\n     if len(operations) != 1 or len(loop_counts) != 1:\n         raise ValueError(\"batch requests must share an operation and execution boundary\")",
