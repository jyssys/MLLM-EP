 import numpy as np
 
+
+def _parse_int_set(value: str):
+    """Parse a comma-separated set of integers used by diagnostic controls."""
+    return {int(item) for item in value.split(",") if item.strip()}
+
+
+def _sensitivity_intervention_active(layer_id: int, *modes: str) -> bool:
+    """Return whether the current measured refinement wave is intervened on.
+
+    This is intentionally environment-driven: dInfer's manual multi-process
+    runner executes every rank deterministically, and the benchmark can change
+    one policy between complete generation runs without reconstructing the
+    100B model. Prefill and warmup are always excluded.
+    """
+    mode = os.environ.get("LLADA_INTERVENTION_MODE", "none")
+    if modes and mode not in modes:
+        return False
+    if mode == "none" or os.environ.get("LLADA_REQUEST_ID", "").startswith("warmup"):
+        return False
+    phase = os.environ.get("LLADA_CURRENT_REFINEMENT_PHASE", "prefill")
+    if phase == "prefill":
+        return False
+    layers = _parse_int_set(os.environ.get("LLADA_INTERVENTION_LAYERS", ""))
+    if layers and layer_id not in layers:
+        return False
+    phases = {
+        item.strip()
+        for item in os.environ.get(
+            "LLADA_INTERVENTION_PHASES", "early,middle,late"
+        ).split(",")
+        if item.strip()
+    }
+    if phases and phase not in phases:
+        return False
+    waves_raw = os.environ.get("LLADA_INTERVENTION_WAVES", "")
+    if waves_raw:
+        wave = int(os.environ.get("LLADA_CURRENT_REFINEMENT_WAVE", "-1"))
+        if wave not in _parse_int_set(waves_raw):
+            return False
+    return True
+
 def torch_all_gather(input_: torch.Tensor) -> torch.Tensor:
